#!/usr/bin/env php
<?php

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("Este script solo se ejecuta desde la linea de comandos.\n");
}

$raiz = dirname(__DIR__);

require_once $raiz . '/app/config.php';
require_once $raiz . '/app/database.php';
require_once $raiz . '/app/migracion.php';
require_once $raiz . '/app/padron.php';
require_once $raiz . '/app/migracion_instituto.php';
require_once $raiz . '/app/semilla.php';

$comando = $argv[1] ?? 'ayuda';

function escribir(string $linea = ''): void
{
    fwrite(STDOUT, $linea . PHP_EOL);
}

function titulo(string $texto): void
{
    escribir();
    escribir($texto);
    escribir(str_repeat('-', mb_strlen($texto)));
}

function crear_base_de_datos(): void
{
    $cfg = app_config()['db'];
    $servidor = db_servidor();
    $servidor->exec(sprintf(
        'CREATE DATABASE IF NOT EXISTS `%s` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci',
        str_replace('`', '', $cfg['name'])
    ));
}

function resumen_tabla(): array
{
    $tablas = ['alumnos', 'secciones', 'encargados', 'profesores', 'paseos', 'viajes', 'pasajeros', 'pagos', 'personal_salvamento', 'asientos'];
    $resumen = [];

    foreach ($tablas as $tabla) {
        if (!tabla_existe($tabla)) {
            $resumen[$tabla] = 0;
            continue;
        }

        $resumen[$tabla] = (int) db()->query('SELECT COUNT(*) FROM `' . $tabla . '`')->fetchColumn();
    }

    return $resumen;
}

function mostrar_resumen(): void
{
    titulo('Resumen de la base de datos');

    foreach (resumen_tabla() as $tabla => $total) {
        escribir(sprintf('  %-22s %d', $tabla, $total));
    }
}

/**
 * Lee los argumentos --clave o --clave=valor de la línea de comandos.
 */
function opciones_cli(array $argumentos): array
{
    $opciones = [];

    foreach ($argumentos as $argumento) {
        if (!str_starts_with($argumento, '--')) {
            continue;
        }

        $partes = explode('=', substr($argumento, 2), 2);
        $opciones[$partes[0]] = count($partes) === 2 ? $partes[1] : true;
    }

    return $opciones;
}

/**
 * Imprime el resultado de la migración del instituto.
 */
function mostrar_informe(array $informe, bool $simular): void
{
    titulo($simular ? 'Informe de la migración (simulación, sin escribir)' : 'Informe de la migración');

    escribir('Origen:  ' . $informe['origen']['archivo']);
    escribir(sprintf('  %-22s %d', 'profesores', $informe['origen']['profesores']));
    escribir(sprintf('  %-22s %d', 'secciones', $informe['origen']['secciones']));
    escribir(sprintf('  %-22s %d', 'estudiantes', $informe['origen']['estudiantes']));
    escribir();

    $profesores = $informe['profesores'];
    escribir('Profesores');
    escribir('  insertados             ' . $profesores['insertados']);
    escribir('  actualizados           ' . $profesores['actualizados']);
    escribir('  sin cambios            ' . $profesores['sin_cambios']);

    foreach ($profesores['errores'] as $error) {
        escribir('  ERROR · ' . $error['codigo'] . ' → ' . $error['motivo']);
    }

    escribir();

    $secciones = $informe['secciones'];
    escribir('Secciones');
    escribir('  insertadas             ' . $secciones['insertados']);
    escribir('  actualizadas           ' . $secciones['actualizados']);
    escribir('  sin cambios            ' . $secciones['sin_cambios']);

    foreach ($secciones['errores'] as $error) {
        escribir('  ERROR · ' . $error['nombre'] . ' → ' . $error['motivo']);
    }

    escribir();

    $encargados = $informe['encargados'];
    escribir('Encargados');
    escribir('  creados                ' . $encargados['creados']);
    escribir('  reutilizados           ' . $encargados['reutilizados']);

    foreach ($encargados['errores'] as $error) {
        escribir('  ERROR · ' . $error);
    }

    foreach ($encargados['conflictos'] as $conflicto) {
        escribir('  AVISO · ' . $conflicto['encargado'] . ' llega con teléfonos distintos: '
            . implode(' / ', $conflicto['telefonos']) . ' (se conserva el primero)');
    }

    escribir();

    $alumnos = $informe['alumnos'];
    escribir('Alumnos');
    escribir('  insertados             ' . $alumnos['insertados']);
    escribir('  actualizados           ' . $alumnos['actualizados']);
    escribir('  sin cambios            ' . $alumnos['sin_cambios']);
    escribir('  viajan con encargado   ' . $alumnos['con_encargado']);
    escribir('  sin encargado          ' . $alumnos['sin_encargado']);
    escribir('  pagados al 100%        ' . $alumnos['pagados']);
    escribir('  bloqueados             ' . $alumnos['bloqueados']);

    foreach ($alumnos['errores'] as $error) {
        escribir('  ERROR · ' . ($error['codigo'] !== '' ? $error['codigo'] : '(sin código)')
            . ' ' . $error['nombre'] . ' → ' . $error['motivo']);
    }

    if ($alumnos['por_seccion'] !== []) {
        escribir();
        escribir('  Migrados por sección:  ' . implode(', ', array_map(
            static fn (string $seccion, int $total): string => $seccion . '=' . $total,
            array_keys($alumnos['por_seccion']),
            $alumnos['por_seccion']
        )));
    }
}

switch ($comando) {
    case 'instalar':
        titulo('Instalación de RideRoster');
        $cfg = app_config()['db'];
        escribir('Servidor:  ' . $cfg['host'] . ':' . $cfg['port']);
        escribir('Base:     ' . $cfg['name']);
        escribir('Usuario:  ' . $cfg['user']);

        crear_base_de_datos();
        escribir('Base de datos creada o verificada.');

        aplicar_esquema_sql();
        escribir('Esquema aplicado.');

        aplicar_migraciones(true);
        escribir('Migraciones aplicadas (version ' . parametro_int('esquema_version', 0) . ').');

        $totalPaseos = (int) db()->query('SELECT COUNT(*) FROM paseos')->fetchColumn();
        $totalViajes = (int) db()->query('SELECT COUNT(*) FROM viajes')->fetchColumn();

        if ($totalPaseos === 0 && $totalViajes === 0) {
            sembrar_datos(db());
            escribir('Datos de demostracion cargados.');
        } else {
            escribir('Se conservaron los datos existentes (' . $totalPaseos . ' paseos, ' . $totalViajes . ' viajes).');
        }

        mostrar_resumen();
        escribir();
        escribir('Listo. Inicia el sistema con: php -S localhost:8080 -t ' . dirname(__DIR__));
        break;

    case 'migrar':
        titulo('Actualizacion del esquema');
        aplicar_migraciones(true);
        escribir('Esquema actualizado (version ' . parametro_int('esquema_version', 0) . ').');
        mostrar_resumen();
        break;

    case 'estado':
        titulo('Estado del sistema');
        $cfg = app_config()['db'];
        escribir('Servidor:  ' . $cfg['host'] . ':' . $cfg['port']);
        escribir('Base:     ' . $cfg['name']);
        escribir('Usuario:  ' . $cfg['user']);

        try {
            db()->query('SELECT 1')->fetchColumn();
            escribir('Conexion: correcta');
            escribir('Esquema:  version ' . parametro_int('esquema_version', 0)
                . ' (' . (tablas_principales_existen() ? 'completo' : 'incompleto') . ')');
            mostrar_resumen();
        } catch (Throwable $excepcion) {
            escribir('Conexion: fallida');
            escribir('Detalle:  ' . $excepcion->getMessage());
            escribir();
            escribir('Ejecuta "php bin/rideroster instalar" para preparar la base de datos.');
        }
        break;

    case 'migrar-instituto':
        titulo('Migración del padrón del Instituto Nacional de Apopa');

        $opciones = opciones_cli(array_slice($argv, 2));
        $simular = isset($opciones['simular']);

        try {
            $archivo = ruta_origen($opciones['archivo'] ?? null);
        } catch (Throwable $excepcion) {
            escribir($excepcion->getMessage());
            exit(1);
        }

        escribir('Archivo:  ' . $archivo);
        escribir('Modo:     ' . ($simular ? 'simulación (todo se revierte al final)' : 'migración real'));
        escribir();

        // 1. Esquema con el padrón de alumnos y el catálogo de profesores.
        aplicar_migraciones(true);

        if (!esquema_padron_disponible()) {
            escribir('El esquema del padrón no está disponible. Ejecuta: php bin/rideroster migrar');
            exit(1);
        }

        escribir('Esquema preparado (versión ' . parametro_int('esquema_version', 0) . ').');

        // 2. Volcado de origen en una base temporal de solo lectura.
        try {
            $origen = abrir_origen($archivo);
        } catch (Throwable $excepcion) {
            escribir('No se pudo leer el origen: ' . $excepcion->getMessage());
            exit(1);
        }

        escribir('Volcado cargado en la base temporal ' . BD_ORIGEN . '.');
        escribir();

        $informe = informe_vacio();
        $informe['origen']['archivo'] = $archivo;

        db()->beginTransaction();

        try {
            if (isset($opciones['limpiar'])) {
                vaciar_padron();
                escribir('Padrón vaciado antes de migrar.');
            }

            migrar_profesores($origen, $informe);
            cargar_secciones($origen, $informe);
            migrar_alumnos($origen, $informe);

            if ($simular) {
                db()->rollBack();
            } else {
                db()->commit();
            }
        } catch (Throwable $excepcion) {
            db()->rollBack();
            escribir('Migración abortada y revertida: ' . $excepcion->getMessage());
            cerrar_origen();
            exit(1);
        }

        cerrar_origen();
        mostrar_informe($informe, $simular);

        $bloqueados = $informe['alumnos']['bloqueados']
            + count($informe['profesores']['errores'])
            + count($informe['secciones']['errores'])
            + count($informe['encargados']['errores']);

        escribir();

        if ($simular) {
            escribir('Simulación terminada: no se guardó ningún cambio.');
        } elseif ($bloqueados > 0) {
            escribir('Migración terminada con ' . $bloqueados . ' registro(s) bloqueado(s), revisa el informe.');
            mostrar_resumen();
        } else {
            escribir('Migración terminada sin errores.');
            mostrar_resumen();
        }

        exit($bloqueados > 0 ? 2 : 0);

    case 'ayuda':
    default:
        titulo('RideRoster · herramienta de linea de comandos');
        escribir();
        escribir('Uso: php bin/rideroster <comando>');
        escribir();
        escribir('  instalar            Crea la base de datos, aplica el esquema y carga datos de demostracion');
        escribir('  migrar              Actualiza el esquema sin borrar informacion');
        escribir('  migrar-instituto    Migra el padron de alumnos, secciones y profesores del instituto');
        escribir('                      Opciones: --archivo=<ruta> --simular --limpiar');
        escribir('  estado              Muestra la conexion y el resumen de la base de datos');
        escribir('  ayuda               Muestra esta ayuda');
        escribir();
        escribir('Conexion: se toma de las variables de entorno DB_HOST, DB_PORT, DB_NAME, DB_USER y DB_PASS.');
        escribir('Sin variables se usan los valores de XAMPP: 127.0.0.1:3306, base rideroster, usuario root.');
        break;
}
